{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=styleai;Username=postgres;Password=postgres"
  },
  "ImageProcessing": {
    "MaxUploadSizeMb": 12,
    "MaxImageWidth": 4096,
    "MaxImageHeight": 4096,
    "ResizeMaxDimension": 1280,
    "RequestTimeoutSeconds": 8,
    "RateLimitPerMinute": 30,
    "ResultStoreTtlMinutes": 30,
    "ResultStoreMaxItems": 5000,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Yolo": {
    "ModelPath": "Models/yolov8n.onnx",
    "ConfidenceThreshold": 0.35,
    "InputWidth": 640,
    "InputHeight": 640
  },
  "Gemini": {
    "ModelId": "gemini-2.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/",
    "TimeoutSeconds": 8,
    "MaxOutputTokens": 120,
    "Temperature": 0.1,
    "MaxRetryAttempts": 1
  },
  "UserContext": {
    "DefaultDeviceToken": "styleai-anonymous-device",
    "DefaultCountryCode": "SA"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
