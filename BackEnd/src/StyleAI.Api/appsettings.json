{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=styleai;Username=postgres;Password=postgres"
  },
  "ImageProcessing": {
    "MaxUploadSizeMb": 12,
    "MaxImageWidth": 4096,
    "MaxImageHeight": 4096,
    "ResizeMaxDimension": 1280,
    "RequestTimeoutSeconds": 8,
    "RateLimitPerMinute": 30,
    "ResultStoreTtlMinutes": 30,
    "ResultStoreMaxItems": 5000,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Yolo": {
    "ModelPath": "Models/yolov8n.onnx",
    "ConfidenceThreshold": 0.35,
    "InputWidth": 640,
    "InputHeight": 640
  },
  "Gemini": {
    "ModelId": "gemini-2.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/",
    "TimeoutSeconds": 8,
    "MaxOutputTokens": 120,
    "Temperature": 0.1,
    "MaxRetryAttempts": 1
  },
  "UserContext": {
    "DefaultDeviceToken": "styleai-anonymous-device",
    "DefaultCountryCode": "SA"
  },
  "Skimlinks": {
    "ProductApiBaseUrl": "http://api-product.skimlinks.com/",
    "TimeoutSeconds": 5,
    "MaxRows": 40,
    "DefaultSearchCountry": "us",
    "PublisherId": 0
  },
  "AffiliateSearch": {
    "ProviderTimeoutSeconds": 5,
    "UseMockWhenProductKeyMissing": true,
    "MaxOffersPerSearch": 100,
    "StreamChannelCapacity": 128,
    "MockStreamDelayMilliseconds": 0,
    "OffersRateLimitPerMinute": 60
  },
  "Normalization": {
    "BaseCurrency": "USD",
    "CountryCurrencies": {
      "SA": "SAR",
      "AE": "AED",
      "KW": "KWD",
      "QA": "QAR",
      "BH": "BHD",
      "OM": "OMR",
      "US": "USD",
      "GB": "GBP",
      "UK": "GBP"
    },
    "ExchangeRatesFromUsd": {
      "USD": 1,
      "SAR": 3.75,
      "AED": 3.67,
      "KWD": 0.31,
      "QAR": 3.64,
      "BHD": 0.38,
      "OMR": 0.38,
      "GBP": 0.79,
      "EUR": 0.92
    }
  },
  "OfferRanking": {
    "PremiumMerchantSlugs": [ "asos", "zara", "namshi", "nordstrom", "farfetch", "revolve", "mango", "hm" ],
    "MaxOriginals": 12,
    "MaxDupes": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
